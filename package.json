{
  "name": "rush-hour-crossing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "start": "tsx server/index.ts --serve-dist",
    "build": "npm run typecheck && vite build",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "preview": "vite preview",
    "test:e2e": "playwright test e2e/smoke.pw.ts e2e/advice.pw.ts e2e/level-generator.pw.ts",
    "evidence:screenshots": "playwright test e2e/evidence.pw.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "zod": "^4.6.5"
  }
}
